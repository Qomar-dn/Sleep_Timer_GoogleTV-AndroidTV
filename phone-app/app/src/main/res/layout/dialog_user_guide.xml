<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="22dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_book"
            app:tint="@color/accent_cyan"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan Cara Penggunaan"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Step 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Sambungkan ke Jaringan Wi-Fi yang Sama"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pastikan HP Anda dan semua Android TV / Google TV yang ingin dikendalikan terhubung ke jaringan Wi-Fi lokal (router) yang sama."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Step 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Pasang &amp; Buka App Server di TV"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Install Devanka-TV-Sleep-Server.apk di TV Anda. Aplikasi server ini akan otomatis berjalan di latar belakang (background) dan otomatis aktif kembali saat TV dinyalakan."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Step 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Pilih Slot TV &amp; Hubungkan (TV 1 s/d TV 5)"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih slot TV yang ingin dikendalikan (TV 1 hingga TV 5). Masukkan alamat IP TV tersebut (misal 192.168.1.78), lalu tekan tombol Hubungkan. Anda juga bisa menekan tombol pensil untuk mengganti nama TV (contoh: TV 1 - PS5)."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Step 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Atur Timer Rental"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih preset waktu sewa cepat (15 Menit, 30 Menit, 45 Menit, 1 Jam, 2 Jam, 3 Jam) atau gunakan pengatur waktu kustom. Lingkaran timer di HP akan menghitung mundur secara real-time."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Step 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Tampilan HUD Melayang di TV &amp; Auto-Sleep"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Di layar TV, badge sisa waktu [ 🎮 SEWA 01:59:59 ] akan melayang di pojok kanan atas di atas permainan game. Saat waktu habis, TV akan otomatis mati/terkunci."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="14dp" />

            <!-- Step 6 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Fitur Bangunkan TV (Wake-on-LAN)"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jika TV sedang mati / standby, tekan tombol Hubungkan di HP. Aplikasi akan otomatis mengirimkan sinyal Wake-on-LAN untuk menyalakan TV dari jarak jauh."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="10dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseGuide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Mengerti"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/accent_purple"
        android:layout_marginTop="16dp"
        app:cornerRadius="8dp" />

</LinearLayout>
